// ----------------------------------------------------------------------
// Cache Settings
// ----------------------------------------------------------------------
// How long to cache metadata like queues, types, states, priorities (in seconds). Set to 0 to disable caching.
$conf['cache']['metadata_lifetime'] = 3600;
// How long to cache report results (in seconds). Set to 0 to disable.
$conf['cache']['report_lifetime'] = 86400;

// ----------------------------------------------------------------------
// Guest Settings
// ----------------------------------------------------------------------
