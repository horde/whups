// Can users reply to ticket emails? If you entered an email address above, and have configured it to accept ticket emai...
$conf['mail']['reply'] = false;
// When generating new tickets or adding ticket comments from email messages, should we include the basic email headers ...
$conf['mail']['include_headers'] = false;
// When generating new tickets or adding ticket comments from email messages, should we include the raw message as an at...
$conf['mail']['attach_message'] = false;
// When someone adds a comment to a ticket, how should we send the comments? ('new' = Only the new comment, 'chronological' = All comments, oldest comments first, 'revchronological' = All comments, most recent comments      first)
$conf['mail']['commenthistory'] = 'new';
// Should ticket emails contain download links for uploaded attachments instead of the attachment itself?
$conf['mail']['link_attach'] = false;
// Should all users responsible for a queue continue to receive email once a ticket is assigned?
$conf['mail']['incl_resp'] = true;
// What server name should be used to create ticket links if using whups-mail-filter?
$conf['mail']['server_name'] = '127.0.0.1';
// What server port should be used to create ticket links if using whups-mail-filter?
$conf['mail']['server_port'] = 80;
